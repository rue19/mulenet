// MuleNet — private cross-institution mule-account corroboration.
// SPDX-License-Identifier: Apache-2.0
//
// Spec: docs/ARCHITECTURE.md §6, with the design decisions in PLAN.md §1:
//   - flag leaves carry no index; revocation derives the index from the Merkle path
//   - anonymous per-epoch quotas on flags and revocations
//   - range checks on governance parameters; proposal expiry on approve

pragma language_version >= 0.22 && <= 0.23;
import CompactStandardLibrary;

// ───────────────────────── Types ─────────────────────────

export struct Attestation {
  epoch: Uint<32>;
  k: Uint<8>;
  typology: Uint<8>;
  escalationCtHash: Bytes<32>;
  querierTag: Bytes<32>;
}

// kind: 1=RegisterInstitution 2=RotateMembership 3=SetCorroborationK 4=AuthorizeDisclosure 5=SetTtl
export struct Proposal {
  kind: Uint<8>;
  payload: Bytes<32>;
  approvals: Uint<8>;
  executed: Boolean;
  createdEpoch: Uint<32>;
}

export struct FlagSlot {
  pseudonym: Bytes<32>;
  epoch: Uint<32>;
  ctHash: Bytes<32>;
  path: MerkleTreePath<20, Bytes<32>>;
}

// ───────────────────────── Ledger ─────────────────────────

export ledger guardians: HistoricMerkleTree<4, Bytes<32>>;
export sealed ledger guardianThreshold: Uint<8>;
export ledger membershipGen: Uint<32>;
export ledger institutions: HistoricMerkleTree<6, Bytes<32>>;
export ledger corroborationK: Uint<8>;

export ledger flags: HistoricMerkleTree<20, Bytes<32>>;
export ledger flagCount: Counter;
export ledger flagNullifiers: Set<Bytes<32>>;
export ledger quotaNullifiers: Set<Bytes<32>>;
export ledger revocationCount: Counter;
export sealed ledger flagQuota: Uint<16>;
export sealed ledger revokeQuota: Uint<16>;

export ledger currentEpoch: Uint<32>;
export ledger nextEpochAt: Uint<64>;
export sealed ledger epochLength: Uint<64>;
export ledger epochTtl: Uint<32>;

export ledger attestations: Map<Bytes<32>, Attestation>;
export ledger attestationCount: Counter;

export ledger proposals: Map<Bytes<32>, Proposal>;
export ledger proposalNonce: Counter;
export ledger voteNullifiers: Set<Bytes<32>>;
export ledger disclosures: Map<Bytes<32>, Uint<32>>;

// ───────────────────────── Witnesses ─────────────────────────

witness institutionSecret(): Bytes<32>;
witness guardianSecret(): Bytes<32>;

// ───────────────────────── Encoding and hashes (§5.3) ─────────────────────────

pure circuit u8b(x: Uint<8>): Bytes<32> { return (x as Field) as Bytes<32>; }
pure circuit u16b(x: Uint<16>): Bytes<32> { return (x as Field) as Bytes<32>; }
pure circuit u32b(x: Uint<32>): Bytes<32> { return (x as Field) as Bytes<32>; }
pure circuit u64b(x: Uint<64>): Bytes<32> { return (x as Field) as Bytes<32>; }

export pure circuit institutionLeaf(sk: Bytes<32>, gen: Uint<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "mulenet:inst:v1"), sk, u32b(gen)]);
}

export pure circuit guardianLeaf(gs: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "mulenet:guardian:v1"), gs]);
}

export pure circuit pseudonym(sk: Bytes<32>, t: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "mulenet:pseud:v1"), sk, t]);
}

export pure circuit flagLeaf(t: Bytes<32>, p: Bytes<32>, e: Uint<32>, ty: Uint<8>, ct: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<6, Bytes<32>>>([pad(32, "mulenet:flag:v1"), t, p, u32b(e), u8b(ty), ct]);
}

export pure circuit flagNullifier(sk: Bytes<32>, t: Bytes<32>, e: Uint<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([pad(32, "mulenet:flagnf:v1"), sk, t, u32b(e)]);
}

export pure circuit flagQuotaNullifier(sk: Bytes<32>, e: Uint<32>, slot: Uint<16>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([pad(32, "mulenet:quota:v1"), sk, u32b(e), u16b(slot)]);
}

export pure circuit revokeQuotaNullifier(sk: Bytes<32>, e: Uint<32>, slot: Uint<16>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([pad(32, "mulenet:rvquota:v1"), sk, u32b(e), u16b(slot)]);
}

export pure circuit attestationKey(t: Bytes<32>, e: Uint<32>, ty: Uint<8>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([pad(32, "mulenet:att:v1"), t, u32b(e), u8b(ty)]);
}

export pure circuit querierTag(sk: Bytes<32>, key: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "mulenet:qtag:v1"), sk, key]);
}

export pure circuit proposalId(kind: Uint<8>, payload: Bytes<32>, nonce: Uint<64>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([pad(32, "mulenet:prop:v1"), u8b(kind), payload, u64b(nonce)]);
}

export pure circuit voteNullifier(gs: Bytes<32>, id: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "mulenet:vote:v1"), gs, id]);
}

export pure circuit valueCommitment(v: Uint<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "mulenet:value:v1"), u32b(v)]);
}

// Leaf position encoded by a path: entry i is the level-i sibling; goes_left means
// the running node is a left child, i.e. bit i of the index is 0.
export pure circuit pathIndex(p: MerkleTreePath<20, Bytes<32>>): Field {
  const r = fold((acc: Vector<2, Field>, e: MerkleTreePathEntry): Vector<2, Field> =>
                   [e.goes_left ? acc[0] : acc[0] + acc[1], acc[1] + acc[1]],
                 [0, 1], p.path);
  return r[0];
}

// ───────────────────────── Authorisation ─────────────────────────

circuit assertInstitution(sk: Bytes<32>, path: MerkleTreePath<6, Bytes<32>>): [] {
  // Binding assert first: a path replayed from another bank's transaction fails here.
  assert(path.leaf == institutionLeaf(sk, membershipGen), "not bound");
  assert(institutions.checkRoot(disclose(merkleTreePathRoot<6, Bytes<32>>(path))), "not a member");
}

circuit assertGuardian(gs: Bytes<32>, path: MerkleTreePath<4, Bytes<32>>): [] {
  assert(path.leaf == guardianLeaf(gs), "not bound");
  assert(guardians.checkRoot(disclose(merkleTreePathRoot<4, Bytes<32>>(path))), "not a guardian");
}

circuit minFreshEpoch(): Uint<32> {
  return currentEpoch > epochTtl ? (currentEpoch - epochTtl) as Uint<32> : 0 as Uint<32>;
}

// ───────────────────────── Constructor ─────────────────────────

constructor(g0: Bytes<32>, g1: Bytes<32>, g2: Bytes<32>, t: Uint<8>, k: Uint<8>,
            epochLen: Uint<64>, firstRollAt: Uint<64>, ttl: Uint<32>,
            fQuota: Uint<16>, rQuota: Uint<16>) {
  assert(t >= 1 && t <= 3, "bad threshold");
  assert(k >= 2 && k <= 3, "bad k");
  assert(ttl >= 1 && ttl <= 90, "bad ttl");
  assert(fQuota >= 1 && rQuota >= 1, "bad quota");
  guardians.insert(disclose(g0));
  guardians.insert(disclose(g1));
  guardians.insert(disclose(g2));
  guardianThreshold = disclose(t);
  corroborationK = disclose(k);
  epochLength = disclose(epochLen);
  nextEpochAt = disclose(firstRollAt);
  epochTtl = disclose(ttl);
  flagQuota = disclose(fQuota);
  revokeQuota = disclose(rQuota);
  currentEpoch = 0;
  membershipGen = 0;
}

// ───────────────────────── Epochs ─────────────────────────

export circuit advanceEpoch(): [] {
  assert(blockTimeGte(nextEpochAt), "too early");
  currentEpoch = (currentEpoch + 1) as Uint<32>;
  nextEpochAt = (nextEpochAt + epochLength) as Uint<64>;
  flags.resetHistory();
}

// ───────────────────────── Flags ─────────────────────────

export circuit submitFlag(t: Bytes<32>, typology: Uint<8>, ctHash: Bytes<32>, quotaSlot: Uint<16>,
                          instPath: MerkleTreePath<6, Bytes<32>>): [] {
  const sk = institutionSecret();
  assertInstitution(sk, instPath);
  const e = currentEpoch;

  assert(quotaSlot < flagQuota, "quota");
  const qn = disclose(flagQuotaNullifier(sk, e, quotaSlot));
  assert(!quotaNullifiers.member(qn), "quota slot used");
  quotaNullifiers.insert(qn);

  const nf = disclose(flagNullifier(sk, t, e));
  assert(!flagNullifiers.member(nf), "duplicate flag");
  flagNullifiers.insert(nf);

  // insert() takes the next free index on-chain, so concurrent flags do not conflict.
  flags.insert(disclose(flagLeaf(t, pseudonym(sk, t), e, typology, ctHash)));
  flagCount.increment(1);
}

export circuit revokeFlag(t: Bytes<32>, flagEpoch: Uint<32>, typology: Uint<8>, ctHash: Bytes<32>,
                          index: Uint<64>, quotaSlot: Uint<16>,
                          leafPath: MerkleTreePath<20, Bytes<32>>,
                          instPath: MerkleTreePath<6, Bytes<32>>): [] {
  const sk = institutionSecret();
  assertInstitution(sk, instPath);

  assert(quotaSlot < revokeQuota, "quota");
  const qn = disclose(revokeQuotaNullifier(sk, currentEpoch, quotaSlot));
  assert(!quotaNullifiers.member(qn), "quota slot used");
  quotaNullifiers.insert(qn);

  // Only the original flagger can reproduce the leaf: the pseudonym needs sk.
  assert(leafPath.leaf == flagLeaf(t, pseudonym(sk, t), flagEpoch, typology, ctHash), "not yours");
  assert(pathIndex(leafPath) == (index as Field), "wrong index");
  assert(flags.checkRoot(disclose(merkleTreePathRoot<20, Bytes<32>>(leafPath))), "unknown flag");

  flags.insertIndexDefault(disclose(index));
  flags.resetHistory();  // roots that still contain the leaf stop verifying immediately
  revocationCount.increment(1);
}
