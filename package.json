{
  "name": "mulenet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "contracts",
    "packages/*",
    "services/*",
    "apps/*",
    "verify",
    "tests/*",
    "tools/*"
  ],
  "scripts": {
    "check-versions": "node scripts/check-versions.mjs",
    "compact": "npm run compact -w contracts",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:up": "npm run dev:up -w tests/integration",
    "test:integration": "npm run test:integration -w tests/integration",
    "leak-scan": "tsx tools/leak-scan/src/cli.ts",
    "check-dedupe": "node scripts/check-dedupe.mjs",
    "keygen": "npm run keygen -w packages/sdk --",
    "test:e2e": "npm run test:e2e -w tests/e2e"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "smoldot": "npm:empty-npm-package@1.0.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  },
  "allowScripts": {
    "classic-level@3.0.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "cbor-extract": false,
    "cpu-features": false,
    "msgpackr-extract": false,
    "ssh2": false
  }
}
